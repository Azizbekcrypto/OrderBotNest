# Bu faylni nusxalab .env deb nomlang. .env git'ga tushmaydi.

# @BotFather beradi (Telegramda /newbot)
BOT_TOKEN=

# Admin bo'ladigan Telegram id'lar, vergul bilan (o'zingiznikini @userinfobot dan oling)
ADMIN_TELEGRAM_IDS=

# PostgreSQL (lokal: PG-1 darsida o'rnatilgan). Baza oldindan yaratilgan bo'lsin: CREATE DATABASE shop;
DATABASE_URL=postgresql://postgres:parol@localhost:5432/shop

# true — TypeORM har SQL so'rovni terminalga yozadi (o'rganish uchun qulay)
DB_LOGGING=true

# Server porti (hosting o'zi beradi, lokalda tegmaysiz)
PORT=3000
