{
  "name": "order-bot-nest",
  "version": "1.0.0",
  "description": "CoddyCamp mentor kursi: Telegram buyurtma boti — NestJS + Telegraf + TypeORM + PostgreSQL",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "tsc --noEmit",
    "test": "jest",
    "seed": "ts-node src/infrastructure/seed.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/infrastructure/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/infrastructure/data-source.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/infrastructure/data-source.ts src/infrastructure/migrations/auto",
    "smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/typeorm": "^11.0.3",
    "dotenv": "^17.2.3",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "telegraf": "4.16.0",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "jest": "^30.0.0",
    "prettier": "^3.5.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
